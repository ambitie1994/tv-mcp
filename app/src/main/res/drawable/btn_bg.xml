<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2D5FA8" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/accent_focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#244C85" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_alt" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/stroke" />
        </shape>
    </item>
</selector>
