<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC2D5FA8" />
            <stroke android:width="1dp" android:color="#CC4F8CFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B31A1D24" />
            <stroke android:width="1dp" android:color="#663A4150" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
